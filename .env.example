# Race Receipt: environment variables.
# Copy to .env.local (git-ignored) and fill in. Never commit real values.
# Where each value comes from: docs/shopify-setup.md

# ---- Shopify store -----------------------------------------------------------
# Your store's myshopify domain, e.g. race-receipt-dev.myshopify.com
SHOPIFY_STORE_DOMAIN=
# Storefront and Admin API version used by every request
SHOPIFY_API_VERSION=2026-10
# Handle of the single placeholder product
SHOPIFY_PRODUCT_HANDLE=race-receipt

# ---- Storefront API (Headless channel) ---------------------------------------
# Public token: safe in browsers, but this app doesn't need it yet (cart creation runs on our server).
SHOPIFY_STOREFRONT_PUBLIC_TOKEN=
# Private token: SERVER ONLY. Used to look up variants and create carts.
SHOPIFY_STOREFRONT_PRIVATE_TOKEN=

# ---- Admin API (Dev Dashboard app) -------------------------------------------
# No static Admin token: the server exchanges these for a 24-hour token (client credentials grant).
SHOPIFY_CLIENT_ID=
# SERVER ONLY. Also the key that signs webhooks (X-Shopify-Hmac-SHA256).
SHOPIFY_CLIENT_SECRET=

# ---- This site ---------------------------------------------------------------
# Public URL of the site (no trailing slash)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Where the worker loads the internal /render page; defaults to NEXT_PUBLIC_SITE_URL
RENDER_BASE_URL=
# SERVER ONLY. Signs internal render-page links. Generate with: openssl rand -base64 32
RENDER_SECRET=

# ---- Local storage -----------------------------------------------------------
DATABASE_URL=file:./data/race-receipt.db
STORAGE_DIR=./storage

# ---- Renderer ----------------------------------------------------------------
# Optional: "chrome" renders with your installed Google Chrome instead of
# Playwright's bundled Chromium (npx playwright install chromium).
RENDER_BROWSER_CHANNEL=
